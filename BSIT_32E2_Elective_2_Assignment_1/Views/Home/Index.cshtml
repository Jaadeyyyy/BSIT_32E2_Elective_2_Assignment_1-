@model IEnumerable<BSIT_32E2_Elective_2_Assignment_1.Models.Questions>

@{
    ViewData["Title"] = "Elective 2 - Assignment 1";
}

<style>
    .hero-banner {
        background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 100%);
        color: #ffffff;
        border-radius: 16px;
        padding: 2.5rem 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 25px rgba(67, 56, 202, 0.2);
    }
    .quiz-box {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #ffffff;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .quiz-box:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    }
    .choice-pill {
        padding: 0.65rem 1rem;
        border-radius: 8px;
        margin-bottom: 0.5rem;
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: 0.92rem;
        color: #475569;
    }
    .choice-selected {
        background-color: #eef2ff;
        border: 2px solid #4f46e5;
        color: #1e1b4b;
        font-weight: 600;
    }
    .answer-footer {
        background-color: #f0fdf4;
        border-top: 1px solid #bbf7d0;
        padding: 0.85rem 1.25rem;
        border-bottom-left-radius: 14px;
        border-bottom-right-radius: 14px;
        color: #166534;
        font-size: 0.9rem;
    }
</style>

<div class="container py-3">
    <div class="hero-banner d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div>
            <span class="badge bg-warning text-dark mb-2 px-3 py-1 rounded-pill fw-semibold">BSIT 32E2 • Elective 2</span>
            <h1 class="h2 fw-bold mb-1">Assignment 1: Web API & MVC Review</h1>
            <p class="mb-0 text-white-50">ASP.NET Core Architecture, Controllers, Routing & RESTful Standards</p>
        </div>
        <div class="mt-3 mt-md-0 text-md-end">
            <div class="fs-3 fw-bold">@Model.Count() / @Model.Count()</div>
            <div class="small text-white-50">Questions Answered</div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var q in Model)
        {
            <div class="col-12 col-lg-6">
                <div class="quiz-box">
                    <div class="p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary px-3 py-2">
                                Question #@q.Id
                            </span>
                            <span class="text-muted small fw-medium">@q.Topic</span>
                        </div>

                        <h5 class="fw-bold text-dark mb-3" style="line-height: 1.4;">
                            @q.Prompt
                        </h5>

                        <div>
                            @foreach (var choice in q.Choices)
                            {
                                bool isMatch = choice == q.Answer;
                                <div class="choice-pill @(isMatch ? "choice-selected" : "")">
                                    @if (isMatch)
                                    {
                                        <span class="me-1">?</span>
                                    }
                                    @choice
                                </div>
                            }
                        </div>
                    </div>

                    <div class="answer-footer">
                        <strong>Selected Answer:</strong> @q.Answer
                    </div>
                </div>
            </div>
        }
    </div>
</div>
